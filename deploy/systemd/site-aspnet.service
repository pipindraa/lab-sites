[Unit]
Description=Lab site-aspnet (Kestrel :5001)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/site-aspnet
ExecStart=/usr/bin/dotnet /opt/site-aspnet/bin/Release/net10.0/site-aspnet.dll
Restart=on-failure
Environment=ASPNETCORE_URLS=http://127.0.0.1:5001

[Install]
WantedBy=multi-user.target
